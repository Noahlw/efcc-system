@@ -0,0 +1,51 @@
+import { expect, test } from "../support/fixtures";
+import { postSeed, queryLocalSql, runLocalSql } from "./seed";
+
+test(
+  "fixture SQL and live app share the migrated disposable D1",
+  { tag: "@http" },
+  async ({ request }) => {
+    const account = {
+      email: "binding@example.invalid",
+      fullName: "測試資料隔離",
+      membershipStatus: "active" as const,
+      password: "Synthetic-binding-password!",
+      phone: "61234567",
+      username: "foundation.binding",
+    };
+    await postSeed({ accounts: [account] });
+    const rows = await queryLocalSql<{ username: string }>(
+      "SELECT username FROM user WHERE username = 'foundation.binding'"
+    );
+    expect(rows).toEqual([{ username: account.username }]);
+    const signIn = await request.post("/api/auth/sign-in/username", {
+      data: { password: account.password, username: account.username },
+    });
+    expect(signIn.status()).toBe(200);
+    await runLocalSql(
+      "UPDATE person_profile SET membership_status = 'pending' WHERE user_id = (SELECT id FROM user WHERE username = 'foundation.binding')"
+    );
+    const me = await request.get("/api/v2/me");
+    expect(me.status()).toBe(403);
+    await runLocalSql(
+      "UPDATE person_profile SET membership_status = 'active' WHERE user_id = (SELECT id FROM user WHERE username = 'foundation.binding')"
+    );
+    const restored = await request.get("/api/v2/me");
+    expect(restored.status()).toBe(200);
+    // Trigger bodies contain embedded semicolons: use Wrangler's canonical SQL
+    // splitter, not newline splitting or a second independent test schema.
+    await runLocalSql(`CREATE TRIGGER foundation_abort BEFORE UPDATE ON person_profile
+  BEGIN SELECT RAISE(ABORT, 'synthetic foundation fault'); END;`);
+    try {
+      await expect(
+        runLocalSql(
+          "UPDATE person_profile SET membership_status = 'pending' WHERE user_id = (SELECT id FROM user WHERE username = 'foundation.binding')"
+        )
+      ).rejects.toThrow();
+      const unchanged = await request.get("/api/v2/me");
+      expect(unchanged.status()).toBe(200);
+    } finally {
+      await runLocalSql("DROP TRIGGER foundation_abort");
+    }
+  }
+);
