+import { spawnSync } from "node:child_process";
+import {
+  existsSync,
+  mkdirSync,
+  mkdtempSync,
+  readFileSync,
+  rmSync,
+  writeFileSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+
+import { afterEach, expect, test } from "vitest";
+
+import { selectTests } from "../../scripts/test-selection";
+import {
+  exportTestSnapshot,
+  gitOutput,
+  verifyIndexUnchanged,
+} from "../../scripts/test-snapshot";
+
+const owned: string[] = [];
+afterEach(() => {
+  for (const directory of owned.splice(0)) {
+    rmSync(directory, { force: true, recursive: true });
+  }
+});
+
+const repository = () => {
+  const root = mkdtempSync(path.join(tmpdir(), "efcc-gate-check-"));
+  owned.push(root);
+  gitOutput(root, "init", "--quiet");
+  gitOutput(root, "config", "user.name", "Synthetic tester");
+  gitOutput(root, "config", "user.email", "synthetic@example.invalid");
+  writeFileSync(path.join(root, ".gitignore"), ".dev.vars\n.wrangler/\n");
+  writeFileSync(path.join(root, "logic.ts"), "export const value = 1;\n");
+  gitOutput(root, "add", ".");
+  gitOutput(
+    root,
+    "-c",
+    "core.hooksPath=/dev/null",
+    "commit",
+    "--quiet",
+    "-m",
+    "synthetic baseline"
+  );
+  return root;
+};
+
+test("staged exports cannot use an unstaged fix or copy developer vars/D1", () => {
+  const root = repository();
+  writeFileSync(
+    path.join(root, "logic.ts"),
+    "export const value = 'staged bug';\n"
+  );
+  gitOutput(root, "add", "logic.ts");
+  writeFileSync(
+    path.join(root, "logic.ts"),
+    "export const value = 'unstaged fix';\n"
+  );
+  writeFileSync(path.join(root, ".dev.vars"), "SYNTHETIC_SENTINEL=untouched\n");
+  mkdirSync(path.join(root, ".wrangler"));
+  writeFileSync(path.join(root, ".wrangler", "sentinel"), "untouched");
+  const snapshot = exportTestSnapshot(root, true);
+  owned.push(snapshot.directory);
+  expect(
+    readFileSync(path.join(snapshot.directory, "logic.ts"), "utf-8")
+  ).toContain("staged bug");
+  expect(existsSync(path.join(snapshot.directory, ".dev.vars"))).toBe(false);
+  expect(existsSync(path.join(snapshot.directory, ".wrangler"))).toBe(false);
+  expect(readFileSync(path.join(root, "logic.ts"), "utf-8")).toContain(
+    "unstaged fix"
+  );
+  expect(readFileSync(path.join(root, ".dev.vars"), "utf-8")).toContain(
+    "untouched"
+  );
+  expect(readFileSync(path.join(root, ".wrangler", "sentinel"), "utf-8")).toBe(
+    "untouched"
+  );
+  verifyIndexUnchanged(root, snapshot.indexTree ?? "");
+  gitOutput(root, "add", "logic.ts");
+  expect(() => verifyIndexUnchanged(root, snapshot.indexTree ?? "")).toThrow(
+    "index changed"
+  );
+});
+
+test("feature snapshots include unstaged/untracked source and fingerprints change", () => {
+  const root = repository();
+  const first = exportTestSnapshot(root, false);
+  owned.push(first.directory);
+  writeFileSync(path.join(root, "logic.ts"), "export const value = 2;\n");
+  writeFileSync(path.join(root, "new.ts"), "export const added = true;\n");
+  const second = exportTestSnapshot(root, false);
+  owned.push(second.directory);
+  expect(
+    readFileSync(path.join(second.directory, "logic.ts"), "utf-8")
+  ).toContain("2");
+  expect(existsSync(path.join(second.directory, "new.ts"))).toBe(true);
+  expect(second.snapshotSha256).not.toBe(first.snapshotSha256);
+});
+
+test("unstaged gate policy cannot weaken staged selection", () => {
+  const root = repository();
+  mkdirSync(path.join(root, "scripts"));
+  const policy = path.join(root, "scripts", "test-selection.ts");
+  writeFileSync(policy, "export const policy = 'strict';\n");
+  expect(() => exportTestSnapshot(root, true)).toThrow(
+    "Stage local gate/tooling"
+  );
+  gitOutput(root, "add", ".");
+  writeFileSync(policy, "export const policy = 'weaker';\n");
+  expect(() => exportTestSnapshot(root, true)).toThrow(
+    "Stage local gate/tooling"
+  );
+});
+
+test("deletion/rename paths select consumers and unknown/shared changes escalate", () => {
+  const root = repository();
+  mkdirSync(path.join(root, "src", "features", "home"), { recursive: true });
+  writeFileSync(
+    path.join(root, "src/features/home/notices.ts"),
+    "export {};\n"
+  );
+  gitOutput(root, "add", ".");
+  gitOutput(
+    root,
+    "-c",
+    "core.hooksPath=/dev/null",
+    "commit",
+    "--quiet",
+    "-m",
+    "synthetic home source"
+  );
+  gitOutput(root, "mv", "src/features/home/notices.ts", "new-area.ts");
+  const changed = gitOutput(
+    root,
+    "diff",
+    "--cached",
+    "--name-only",
+    "--no-renames",
+    "-z"
+  )
+    .split("\0")
+    .filter(Boolean);
+  expect(changed).toContain("src/features/home/notices.ts");
+  expect(selectTests(changed).fullRuntime).toBe(true);
+  expect(selectTests(["src/features/home/notices.ts"]).runtimeFiles).toContain(
+    "tests/e2e/home-notices.spec.ts"
+  );
+  expect(selectTests(["tests/shared/church-time.test.ts"]).fullRuntime).toBe(
+    false
+  );
+  expect(selectTests(["docs/testing.md"]).fast).toBe(false);
+  expect(selectTests(["public/icons.svg"]).fullRuntime).toBe(true);
+  expect(selectTests(["src/server/auth/index.ts"]).fullRuntime).toBe(true);
+  expect(
+    selectTests(["tests/e2e/deleted.spec.ts"], ["tests/e2e/deleted.spec.ts"])
+      .fullRuntime
+  ).toBe(true);
+});
+
+test("force-added private vars and D1 are rejected before export", () => {
+  const root = repository();
+  writeFileSync(path.join(root, ".dev.vars"), "SYNTHETIC_SENTINEL=untouched\n");
+  gitOutput(root, "add", "--force", ".dev.vars");
+  expect(() => exportTestSnapshot(root, true)).toThrow(
+    "Developer vars and runtime artifacts"
+  );
+  expect(() => exportTestSnapshot(root, false)).toThrow(
+    "Developer vars and runtime artifacts"
+  );
+  expect(readFileSync(path.join(root, ".dev.vars"), "utf-8")).toContain(
+    "untouched"
+  );
+});
+
+test("discovery neither creates developer vars nor starts a Worker", () => {
+  const root = path.resolve(import.meta.dirname, "../..");
+  const before = existsSync(path.join(root, ".dev.vars"));
+  const result = spawnSync("pnpm", ["exec", "playwright", "test", "--list"], {
+    cwd: root,
+    encoding: "utf-8",
+  });
+  expect(result.status, result.stderr).toBe(0);
+  expect(result.stdout).toContain("[http]");
+  expect(existsSync(path.join(root, ".dev.vars"))).toBe(before);
+});
