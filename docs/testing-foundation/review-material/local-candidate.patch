index 0000000..47079f2
--- /dev/null
+++ b/tests/support/db.ts
@@ -0,0 +1,44 @@
+import path from "node:path";
+
+import { getPlatformProxy, unstable_splitSqlQuery } from "wrangler";
+import type { PlatformProxy } from "wrangler";
+
+let platform: Promise<PlatformProxy<{ DB: D1Database }>> | undefined;
+
+const database = async () => {
+  // The runner exports source into an owned snapshot. Vite, Wrangler fault
+  // workers and this proxy resolve the same config and persisted D1 directory.
+  if (process.env.EFCC_TEST_ROOT !== process.cwd()) {
+    throw new Error("Use pnpm test:e2e to access disposable test D1 state.");
+  }
+  platform ??= getPlatformProxy<{ DB: D1Database }>({
+    configPath: path.resolve("wrangler.jsonc"),
+    envFiles: [],
+    persist: { path: path.resolve(".wrangler/state/v3") },
+    remoteBindings: false,
+  });
+  const current = await platform;
+  return current.env.DB;
+};
+
+/** Independent SQL assertions use the application's persisted local D1. */
+export const queryLocalSql = async <Row>(sql: string): Promise<Row[]> => {
+  const db = await database();
+  const result = await db.prepare(sql).all<Row>();
+  return result.results;
+};
+
+/** Preserve the original statement ordering, including trigger/schema faults. */
+export const runLocalSql = async (sql: string): Promise<void> => {
+  const db = await database();
+  await db.batch(
+    unstable_splitSqlQuery(sql).map((statement) => db.prepare(statement))
+  );
+};
+
+export const closeTestDatabase = async () => {
+  const current = platform;
+  platform = undefined;
+  const resolved = await current;
+  await resolved?.dispose();
+};
