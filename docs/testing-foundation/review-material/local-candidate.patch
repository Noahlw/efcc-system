@@ -0,0 +1,183 @@
+import { spawn } from "node:child_process";
+import { randomBytes } from "node:crypto";
+import { once } from "node:events";
+import { existsSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { createServer } from "node:net";
+import path from "node:path";
+
+import { selectTests } from "./test-selection.ts";
+import {
+  exportTestSnapshot,
+  gitOutput,
+  verifyGatePolicyStaged,
+  verifyIndexUnchanged,
+} from "./test-snapshot.ts";
+
+const root = path.resolve(import.meta.dirname, "..");
+const args = process.argv.slice(2);
+const staged = args[0] === "--staged";
+const list = args.includes("--list");
+const git = (...command: string[]) => gitOutput(root, ...command);
+// Check the executing policy even for docs-only commits; unstaged gate edits
+// must never be able to select an easier suite.
+if (staged) {
+  verifyGatePolicyStaged(root);
+}
+if (staged && git("ls-files", "--unmerged", "-z")) {
+  throw new Error("Resolve index conflicts before local qualification.");
+}
+const selection = staged
+  ? selectTests(
+      git("diff", "--cached", "--name-only", "--no-renames", "-z")
+        .split("\0")
+        .filter(Boolean),
+      git(
+        "diff",
+        "--cached",
+        "--name-only",
+        "--no-renames",
+        "--diff-filter=D",
+        "-z"
+      )
+        .split("\0")
+        .filter(Boolean)
+    )
+  : undefined;
+if (staged && !selection?.fast) {
+  console.log("Local gate: documentation only; no runtime startup.");
+  process.exit(0);
+}
+const { directory: snapshot, ...source } = exportTestSnapshot(root, staged);
+const env: NodeJS.ProcessEnv = {
+  ...process.env,
+  EFCC_TEST_ROOT: snapshot,
+  EFCC_TEST_SOURCE: JSON.stringify(source),
+  // Git hook repository variables must not redirect snapshot tools.
+  GIT_COMMON_DIR: undefined,
+  GIT_DIR: undefined,
+  GIT_INDEX_FILE: undefined,
+  GIT_PREFIX: undefined,
+  GIT_WORK_TREE: undefined,
+  WRANGLER_SEND_METRICS: "false",
+};
+let child: ReturnType<typeof spawn> | undefined;
+let interrupted = false;
+const interrupt = () => {
+  interrupted = true;
+  if (child?.pid) {
+    try {
+      process.kill(-child.pid, "SIGTERM");
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ESRCH") {
+        throw error;
+      }
+    }
+  }
+};
+process.on("SIGINT", interrupt);
+process.on("SIGTERM", interrupt);
+
+const run = async (command: string, commandArgs: string[]) => {
+  if (interrupted) {
+    throw new Error("Local qualification interrupted.");
+  }
+  child = spawn(command, commandArgs, {
+    cwd: snapshot,
+    detached: true,
+    env,
+    stdio: "inherit",
+  });
+  const [code, signal] = await once(child, "close");
+  child = undefined;
+  if (code !== 0 || interrupted) {
+    throw new Error(`${command} failed (${signal ?? code}).`);
+  }
+};
+const freePort = async () => {
+  const server = createServer();
+  server.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  const address = server.address();
+  const closed = once(server, "close");
+  server.close();
+  await closed;
+  if (!address || typeof address === "string") {
+    throw new Error("Could not allocate a local test port.");
+  }
+  return address.port;
+};
+
+let passed = false;
+try {
+  await run("pnpm", [
+    "install",
+    "--offline",
+    "--frozen-lockfile",
+    "--ignore-scripts",
+  ]);
+  if (staged) {
+    await run("pnpm", ["check"]);
+    await run("pnpm", ["typecheck"]);
+    await run("pnpm", ["test"]);
+    const generated = "worker-configuration.d.ts";
+    if (
+      existsSync(path.join(snapshot, generated)) &&
+      git("ls-files", generated).trim()
+    ) {
+      const exported = git("show", `:${generated}`);
+      if (readFileSync(path.join(snapshot, generated), "utf-8") !== exported) {
+        throw new Error(
+          "Generated Worker types changed; regenerate and stage them before retrying."
+        );
+      }
+    }
+  }
+  if (!staged || selection?.fullRuntime || selection?.runtimeFiles.length) {
+    const [port, clockPort, faultPort] = await Promise.all([
+      freePort(),
+      freePort(),
+      freePort(),
+    ]);
+    Object.assign(env, {
+      E2E_BASE_URL: `http://localhost:${port}`,
+      E2E_PORT: String(port),
+      EFCC_CLOCK_PORT: String(clockPort),
+      EFCC_FAULT_PORT: String(faultPort),
+    });
+    if (!list) {
+      writeFileSync(
+        path.join(snapshot, ".dev.vars"),
+        [
+          `BETTER_AUTH_SECRET=${randomBytes(32).toString("hex")}`,
+          `BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:${port},http://127.0.0.1:${port}`,
+          `SEED_TOKEN=${randomBytes(16).toString("hex")}`,
+          "",
+        ].join("\n"),
+        { mode: 0o600 }
+      );
+      await run("pnpm", ["db:migrate:local"]);
+    }
+    const filters =
+      staged && !selection?.fullRuntime
+        ? (selection?.runtimeFiles ?? [])
+        : args.filter((arg) => arg !== "--staged");
+    console.log(
+      `Local test scope: ${selection?.reason ?? "explicit Playwright selection"}; source ${JSON.stringify(source)}`
+    );
+    await run("pnpm", ["exec", "playwright", "test", ...filters]);
+  }
+  if (staged && source.indexTree) {
+    verifyIndexUnchanged(root, source.indexTree);
+  }
+  passed = true;
+} finally {
+  process.off("SIGINT", interrupt);
+  process.off("SIGTERM", interrupt);
+  if (list || (passed && process.env.EFCC_CAPTURE_IMAGES !== "1")) {
+    rmSync(snapshot, { force: true, recursive: true });
+  } else {
+    console.log(
+      `Private ${passed ? "capture evidence" : "failure diagnostics"} retained at ${snapshot}`
+    );
+  }
+}
