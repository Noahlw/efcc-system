--- /dev/null
+++ b/scripts/test-selection.ts
@@ -0,0 +1,64 @@
+export interface TestSelection {
+  reason: string;
+  runtimeFiles: string[];
+  fullRuntime: boolean;
+  fast: boolean;
+}
+
+/** HTTP and dynamically composed server dependencies need an explicit map. */
+export const selectTests = (
+  paths: string[],
+  deleted: string[] = []
+): TestSelection => {
+  const runtimeFiles = new Set<string>();
+  let fullRuntime = false;
+  let fast = false;
+  for (const file of paths) {
+    if (/^(?:docs\/|\.scratch\/)|^(?:README|AGENTS|CONTEXT)\.md$/u.test(file)) {
+      continue;
+    }
+    fast = true;
+    if (
+      /^tests\/(?:shared|ui|types)\//u.test(file) ||
+      file === "tests/worker/public-auth-boundary.test.ts"
+    ) {
+      continue;
+    }
+    if (/^tests\/e2e\/.*\.spec\.ts$/u.test(file)) {
+      if (deleted.includes(file)) {
+        fullRuntime = true;
+      } else {
+        runtimeFiles.add(file);
+      }
+      continue;
+    }
+    if (file.startsWith("src/features/home/")) {
+      for (const spec of [
+        "home-notices",
+        "home-participation",
+        "r11-ui",
+        "zz-worker-faults",
+      ]) {
+        runtimeFiles.add(`tests/e2e/${spec}.spec.ts`);
+      }
+      continue;
+    }
+    // Shared auth, account writers, schemas, frames, configuration, fixture
+    // changes and unknown source areas conservatively require all live tests.
+    fullRuntime = true;
+  }
+  let reason = "documentation only";
+  if (fullRuntime) {
+    reason = "shared or unclassified executable input";
+  } else if (runtimeFiles.size) {
+    reason = "affected runtime test families";
+  } else if (fast) {
+    reason = "fast test/type boundary";
+  }
+  return {
+    fast,
+    fullRuntime,
+    reason,
+    runtimeFiles: [...runtimeFiles].toSorted(),
+  };
+};
diff --git a/scripts/test-snapshot.ts b/scripts/test-snapshot.ts
new file mode 100644
index 0000000..b0ec891
--- /dev/null
+++ b/scripts/test-snapshot.ts
@@ -0,0 +1,143 @@
+import { spawnSync } from "node:child_process";
+import { createHash } from "node:crypto";
+import {
+  cpSync,
+  existsSync,
+  lstatSync,
+  mkdirSync,
+  mkdtempSync,
+  readFileSync,
+  realpathSync,
+  rmSync,
+} from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+
+export const gitOutput = (root: string, ...args: string[]) => {
+  const result = spawnSync("git", args, { cwd: root, encoding: "utf-8" });
+  if (result.status !== 0) {
+    throw new Error(`git ${args[0]} failed: ${result.stderr}`);
+  }
+  return result.stdout;
+};
+
+export const verifyGatePolicyStaged = (root: string) => {
+  const paths = ["scripts", ".husky", "package.json"];
+  if (
+    gitOutput(root, "diff", "--name-only", "--", ...paths) ||
+    gitOutput(
+      root,
+      "ls-files",
+      "--others",
+      "--exclude-standard",
+      "--",
+      ...paths
+    )
+  ) {
+    throw new Error("Stage local gate/tooling changes before qualification.");
+  }
+};
+
+/** Export committed inputs, keeping staged and working-tree evidence distinct. */
+export const exportTestSnapshot = (root: string, staged: boolean) => {
+  const git = (...args: string[]) => gitOutput(root, ...args);
+  if (git("ls-files", "--unmerged", "-z")) {
+    throw new Error("Resolve index conflicts before local qualification.");
+  }
+  if (/^(?:120000|160000) /mu.test(git("ls-files", "--stage"))) {
+    throw new Error(
+      "Local test snapshots do not support symlinks or submodules."
+    );
+  }
+  if (staged) {
+    verifyGatePolicyStaged(root);
+  }
+  const indexTree = staged ? git("write-tree").trim() : undefined;
+  const head = git("rev-parse", "HEAD").trim();
+  const directory = realpathSync(
+    mkdtempSync(path.join(tmpdir(), "efcc-tests-"))
+  );
+  try {
+    const files = git(
+      "ls-files",
+      ...(staged ? [] : ["--cached", "--others", "--exclude-standard"]),
+      "-z"
+    )
+      .split("\0")
+      .filter(Boolean);
+    if (
+      files.some(
+        (file) =>
+          !file.endsWith(".example") &&
+          /(?:^|\/)(?:\.dev\.vars(?:\.|$)|\.env(?:\.|$)|\.wrangler\/|test-results\/|playwright-report\/|node_modules\/)/u.test(
+            file
+          )
+      )
+    ) {
+      throw new Error(
+        "Developer vars and runtime artifacts cannot enter a test snapshot."
+      );
+    }
+    if (staged) {
+      git(
+        "checkout-index",
+        "--all",
+        "--ignore-skip-worktree-bits",
+        `--prefix=${directory}/`
+      );
+    } else {
+      for (const file of files) {
+        const source = path.join(root, file);
+        if (!existsSync(source)) {
+          continue;
+        }
+        if (lstatSync(source).isSymbolicLink()) {
+          throw new Error("Untracked symlinks cannot enter a test snapshot.");
+        }
+        const destination = path.join(directory, file);
+        mkdirSync(path.dirname(destination), { recursive: true });
+        cpSync(source, destination);
+      }
+    }
+    const fingerprint = createHash("sha256");
+    for (const file of files.toSorted()) {
+      const destination = path.join(directory, file);
+      if (existsSync(destination)) {
+        const bytes = readFileSync(destination);
+        if (
+          bytes
+            .subarray(0, 100)
+            .toString()
+            .startsWith("version https://git-lfs.github.com/spec/v1")
+        ) {
+          throw new Error(
+            "Resolve LFS pointers before snapshot qualification."
+          );
+        }
+        fingerprint
+          .update(file)
+          .update("\0")
+          .update(String(bytes.length))
+          .update("\0")
+          .update(bytes);
+      }
+    }
+    return {
+      directory,
+      head,
+      indexTree,
+      snapshotSha256: fingerprint.digest("hex"),
+    };
+  } catch (error) {
+    rmSync(directory, { force: true, recursive: true });
+    throw error;
+  }
+};
+
+export const verifyIndexUnchanged = (root: string, tree: string) => {
+  if (gitOutput(root, "write-tree").trim() !== tree) {
+    throw new Error(
+      "The index changed during qualification; rerun for the new staged tree."
+    );
+  }
+};
