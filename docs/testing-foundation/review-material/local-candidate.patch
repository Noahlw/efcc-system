--- /dev/null
+++ b/tests/support/fixtures.ts
@@ -0,0 +1,52 @@
+import { test as base } from "@playwright/test";
+
+import { closeTestDatabase } from "./db";
+
+export { expect, request } from "@playwright/test";
+
+let nextIp = 0;
+
+// ponytail: mutable schema and causal fault sequences stay serial in each
+// snapshot; use separate runtime stores before increasing Playwright workers.
+export const test = base.extend<
+  { testIp: string },
+  { databaseLifetime: boolean }
+>({
+  databaseLifetime: [
+    // eslint-disable-next-line no-empty-pattern -- Playwright requires destructured fixture dependencies.
+    async ({}, use) => {
+      try {
+        await use(true);
+      } finally {
+        await closeTestDatabase();
+      }
+    },
+    { auto: true, scope: "worker" },
+  ],
+  extraHTTPHeaders: async ({ testIp }, use) => {
+    await use({
+      "cf-connecting-ip": testIp,
+      origin: process.env.E2E_BASE_URL ?? "http://localhost:5199",
+    });
+  },
+  testIp: [
+    // eslint-disable-next-line no-empty-pattern -- Playwright requires destructured fixture dependencies.
+    async ({}, use, info) => {
+      nextIp += 1;
+      const sequence = nextIp;
+      if (sequence > 65_535 || info.workerIndex > 255) {
+        throw new Error("Disposable test IP allocation exhausted.");
+      }
+      // Native auth canonicalizes IPv6 subnets. Distinct exact IPv4 clients
+      // keep unrelated setup out of another case's real limiter window.
